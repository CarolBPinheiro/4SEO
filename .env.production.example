# =============================================================================
# 4SEO — variáveis de PRODUÇÃO (Netlify)
# Copie os nomes/valores no painel: Site configuration → Environment variables
# Scope: Production (e Preview, se quiser o mesmo backend).
# Depois: Deploys → Trigger deploy → Clear cache and deploy site
# =============================================================================

NEXT_PUBLIC_APP_URL=https://4seo.app

# Checkout Asaas (Next) — SEM sufixo /api
# Chama {NEXT_PUBLIC_API_URL}/billing/checkout
NEXT_PUBLIC_API_URL=https://api.4seo.app

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# App autenticado (Vite) — COM sufixo /api
# Chama {VITE_API_BASE_URL}/dashboard/summary → https://api.4seo.app/api/dashboard/summary
VITE_API_BASE_URL=https://api.4seo.app/api

VITE_MARKETING_URL=https://4seo.app
VITE_AUTH_REDIRECT_URL=https://4seo.app/login
