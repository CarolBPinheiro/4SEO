# =============================================================================
# 4SEO — variáveis de PRODUÇÃO (Render → serviço 4seo-backend)
# Preencha secrets no painel. Valores abaixo são os canônicos de domínio.
# Após alterar: Save and deploy (Restart NÃO aplica env nova).
# Runbook: docs/go-live/DOMAINS.md
# =============================================================================

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Só se o projeto assinar JWT com HS256
SUPABASE_JWT_SECRET=

OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
AI_REASONING_EFFORT=minimal
VISION_MODEL=gpt-4o

FRONTEND_URL=https://4seo.app
BACKEND_URL=https://api.4seo.app
CORS_ORIGINS=https://4seo.app,https://www.4seo.app
APP_PUBLIC_URL=https://4seo.app

ENVIRONMENT=production
DISABLE_API_DOCS=true
MAX_PAGES_PER_SCAN=20

SEARCHAPI_KEY=

GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=https://api.4seo.app/api/gsc/callback

NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

LOJAINTEGRADA_APP_KEY=

ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

ADMIN_EMAILS=
ADMIN_USER_IDS=
