# =============================================================================
# 4SEO — Backend (FastAPI / Python)
# =============================================================================
# Copie este arquivo para `backend/.env` e preencha os valores.
#
# Este arquivo contém SEGREDOS reais em produção. Nunca faça commit do `.env`
# preenchido (ele já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — OBRIGATÓRIO
# Onde encontrar: painel do Supabase → Project Settings → API
# -----------------------------------------------------------------------------

# URL do projeto (mesma usada no frontend).
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon). OBRIGATÓRIA: é com ela, combinada ao token JWT do
# usuário, que o backend acessa o banco respeitando o Row Level Security —
# ou seja, é o que garante o isolamento entre contas. Sem ela, as rotas
# autenticadas falham.
SUPABASE_ANON_KEY=

# Chave service_role. Ignora o Row Level Security — use com cuidado.
# É utilizada apenas em operações administrativas e nos fluxos de callback
# OAuth, quando ainda não existe um token de usuário na requisição.
SUPABASE_SERVICE_KEY=

# (Opcional) Segredo JWT legado (HS256). Só é necessário em projetos Supabase
# antigos, que ainda assinam tokens com HS256. Projetos criados recentemente
# usam JWT Signing Keys (ES256) e são validados automaticamente via JWKS,
# dispensando esta variável.
# Onde encontrar: Project Settings → JWT Keys → aba "Legacy JWT Secret"
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Aplicação — OBRIGATÓRIO
# -----------------------------------------------------------------------------

# Origens permitidas para CORS, separadas por vírgula.
# Inclua o app autenticado (Vite) e, se necessário, o marketing (Next.js).
# localhost:8080 e localhost:3000 já entram na lista padrão do código.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# URL pública do app autenticado (Vite). Usada para redirecionar o navegador
# de volta após OAuth (Nuvemshop e Google Search Console).
FRONTEND_URL=http://localhost:8080

# URL pública deste backend. Usada para montar as URLs de callback de OAuth.
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# OpenAI — OBRIGATÓRIO para geração de propostas de otimização
# Sem esta chave, o app continua escaneando e pontuando páginas, mas não
# consegue gerar sugestões de conteúdo por IA.
# -----------------------------------------------------------------------------

OPENAI_API_KEY=

# (Opcional) Modelo de texto. Padrão: gpt-5-mini
AI_MODEL=gpt-5-mini

# (Opcional) Esforço de raciocínio do modelo. Padrão: minimal
AI_REASONING_EFFORT=minimal

# (Opcional) Modelo com visão, usado para gerar texto alternativo de imagens
# de produto. Padrão: gpt-4o
VISION_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Scan / Crawler
# -----------------------------------------------------------------------------

# (Opcional) Máximo de páginas por varredura. Padrão: 20
MAX_PAGES_PER_SCAN=20

# -----------------------------------------------------------------------------
# SearchAPI.io — OPCIONAL
# Enriquece as propostas com dados reais de SERP (resultados de busca).
# Sem esta chave, as propostas são geradas apenas com o contexto do produto.
# -----------------------------------------------------------------------------

SEARCHAPI_KEY=

# -----------------------------------------------------------------------------
# Google Search Console — OPCIONAL
# Habilita as métricas de cliques e impressões orgânicas no painel.
# Onde configurar: Google Cloud Console → APIs e Serviços → Credenciais →
# Criar credencial OAuth 2.0 (tipo "Aplicativo da Web"), habilitando a
# Search Console API. A URI de redirecionamento cadastrada no Google precisa
# ser exatamente igual ao valor de GSC_REDIRECT_URI abaixo.
# -----------------------------------------------------------------------------

GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8000/api/gsc/callback

# -----------------------------------------------------------------------------
# Integrações de e-commerce
# -----------------------------------------------------------------------------
# Só entram no .env as credenciais do APLICATIVO 4SEO no servidor.
# Credenciais da LOJA do lojista (token Shopify legado, App Key VTEX,
# chave da loja na Loja Integrada) são informadas na tela Integrações e salvas por usuário.
# -----------------------------------------------------------------------------

# --- Nuvemshop (OAuth do app 4SEO) — OBRIGATÓRIO para conectar Nuvemshop ---
# Portal de Parceiros → seu aplicativo → App ID + Client Secret.
# Redirect URI no portal: {BACKEND_URL}/api/nuvemshop/oauth-redirect
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=

# --- Shopify (OAuth do app 4SEO) — OBRIGATÓRIO para conectar Shopify via OAuth ---
# Shopify Partners / Dev Dashboard → app 4SEO → Client ID e Client secret.
# Allowed redirection URL: {BACKEND_URL}/api/shopify/oauth-redirect
# Escopos do app: write_products, write_content (e equivalentes read).
# O lojista só informa o nome da loja na UI; o token vem do OAuth.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# (Opcional) Sobrescreve escopos pedidos no authorize. Padrão abaixo.
# SHOPIFY_OAUTH_SCOPES=write_products,write_content

# --- Loja Integrada (chave da aplicação 4SEO) — OBRIGATÓRIO para LI ---
# Chave da APLICAÇÃO no painel/parceiros da Loja Integrada (não a chave da loja).
# O lojista cola só a Chave de API da loja na UI.
LOJAINTEGRADA_APP_KEY=

# --- VTEX — sem variáveis de servidor ---
# O lojista informa na UI: account_name + App Key + App Token
# (License Manager com Product/SKU e Categories Management).

# -----------------------------------------------------------------------------
# Asaas — Billing / Checkout (OBRIGATÓRIO para o checkout da landing)
# Documentação: https://docs.asaas.com/ · Contrato: docs/asaas-backend-contract.md
# Nunca exponha estas chaves no frontend (sem VITE_/NEXT_PUBLIC_).
# -----------------------------------------------------------------------------

# API Key (Sandbox ou Produção). Header access_token nas chamadas Asaas.
# A chave DEVE ser do mesmo ambiente da ASAAS_BASE_URL
# (senão: invalid_environment → checkout falha).
ASAAS_API_KEY=

# Sandbox: https://api-sandbox.asaas.com/v3  (+ chave sandbox)
# Produção: https://api.asaas.com/v3         (+ chave produção)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token do webhook (painel Asaas → Webhooks → authToken).
# Asaas envia no header `asaas-access-token`. Mínimo 32 caracteres.
ASAAS_WEBHOOK_TOKEN=

# URL pública do marketing/app (domínio único) para callbacks Asaas.
# Local: http://localhost:3000 | Produção: https://4seo.app
APP_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Administração da plataforma (um único tipo de acesso — sem RBAC)
# -----------------------------------------------------------------------------
# Lista de e-mails autorizados a acessar /admin e /api/admin/* (separados por vírgula).
ADMIN_EMAILS=

# Alternativa/complemento: UUIDs de auth.users
# ADMIN_USER_IDS=

# production | development — em production, /docs e OpenAPI ficam desligados
ENVIRONMENT=development

# Força desligar docs mesmo fora de production
# DISABLE_API_DOCS=true
