# =============================================================================
# 4SEO — Workspace unificado
# Marketing (Next) + App autenticado (Vite) + Backend (FastAPI/Supabase)
# =============================================================================
# Copie para `.env.local` (Next) e/ou `.env` (Vite).
# Secrets do servidor ficam em `backend/.env` (veja backend/.env.example).
# =============================================================================

# --- Marketing (Next.js :3000) ---
# URL do app autenticado (Vite). Login da landing aponta para {URL}/login
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Billing/checkout — aponta para o FastAPI (rotas /billing/*)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Typebot (opcional)
# NEXT_PUBLIC_TYPEBOT_ID=ajuda-4-seo
# NEXT_PUBLIC_TYPEBOT_API_HOST=https://chat.deangelitech.com.br

# --- App autenticado (Vite :8080) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Em dev, /api é proxied para localhost:8000 (vite.config.ts)
VITE_API_BASE_URL=/api

# Site de marketing (rota "/" do Vite redireciona para cá)
VITE_MARKETING_URL=http://localhost:3000

# (Opcional) redirect de e-mails Supabase Auth
# VITE_AUTH_REDIRECT_URL=http://localhost:8080/login
